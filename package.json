{
  "name": "picture-portal",
  "version": "0.0.1",
  "description": "Baklib 图片资源门户模板",
  "scripts": {
    "build": "npm-run-all build:css build:js",
    "build:css": "npx @tailwindcss/cli -i ./src/stylesheets/application.css -o ./assets/stylesheets/application.css",
    "build:js": "npx esbuild ./src/javascripts/application.js --bundle --drop:console --drop:debugger --minify --outfile=./assets/javascripts/application.js",
    "dev": "npm-run-all --parallel 'build:css -- --watch' 'dev:js -- --watch'",
    "dev:js": "npx esbuild ./src/javascripts/application.js --bundle --outfile=./assets/javascripts/application.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "daisyui": "^5.5.14",
    "esbuild": "^0.25.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "prettier-plugin-liquid": "^0.0.1-security",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4.1.8"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.20",
    "alpinejs": "^3.14.9",
    "mime": "^4.1.0",
    "mustache": "^4.2.0",
    "qs": "^6.14.1",
    "tippy.js": "^6.3.7",
    "viewerjs": "^1.11.7"
  }
}
