{% comment %}
  PDF 预览组件 - 可复用的 partial

  参数:
  - pdf_url: PDF 文件 URL（必需）
  - wasm_url: PDFium WASM 文件 URL（可选，默认使用 asset_url）
  - scale: 初始缩放比例（可选，默认 1.5）
  - class: 外部容器额外的 CSS 类（可选）

  使用示例:
  {% render '_pdf_viewer', pdf_url: entity.url, class: 'h-[600px]' %}
{% endcomment %}

{% assign pdf_url = pdf_url | default: '' %}
{% assign wasm_url = wasm_url | default: '' %}
{% assign scale = scale | default: 1.5 %}
{% assign container_class = class | default: '' %}

{% if wasm_url == '' %}
  {% assign wasm_url = 'javascripts/pdfium.wasm' | asset_url %}
{% endif %}

<div class="{{ container_class }}"
     data-controller="pdf-preview"
     data-pdf-preview-url-value="{{ pdf_url }}"
     data-pdf-preview-wasm-url-value="{{ wasm_url }}"
     data-pdf-preview-scale-value="{{ scale }}">
  <!-- Loading State -->
  <div data-pdf-preview-target="loading" class="hidden absolute inset-0 flex items-center justify-center bg-white/80 dark:bg-gray-900/80 z-10">
    <div class="flex flex-col items-center gap-2">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
      <p class="text-sm text-gray-600 dark:text-gray-400">加载中...</p>
    </div>
  </div>

  <!-- Error State -->
  <div data-pdf-preview-target="error" class="hidden absolute inset-0 flex items-center justify-center bg-white/80 dark:bg-gray-900/80 z-10">
    <div class="flex flex-col items-center gap-2 text-red-500">
      <i class="ri-error-warning-line text-4xl"></i>
      <p class="text-sm">预览加载失败</p>
    </div>
  </div>

  <!-- PDF Preview Container -->
  <div data-pdf-preview-target="container" class="w-full h-full overflow-auto flex items-start justify-center p-2 md:p-4 touch-pan-x touch-pan-y">
    <!-- Canvas will be inserted here by the controller -->
  </div>

  <!-- PDF Controls -->
  <div data-pdf-preview-target="controls" class="hidden absolute bottom-2 md:bottom-4 left-1/2 transform -translate-x-1/2 bg-white dark:bg-gray-800 rounded-lg shadow-lg px-2 md:px-4 py-1.5 md:py-2 flex items-center gap-1 md:gap-2 z-20 text-xs md:text-sm">
    <button type="button"
            data-action="click->pdf-preview#previousPage"
            class="px-2 md:px-3 py-1 text-sm bg-gray-100 dark:bg-gray-700 active:bg-gray-300 dark:active:bg-gray-600 hover:bg-gray-200 dark:hover:bg-gray-600 rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed touch-manipulation"
            title="上一页">
      <i class="ri-arrow-left-line"></i>
    </button>

    <div data-pdf-preview-target="pageInfo" class="px-2 md:px-3 py-1 text-xs md:text-sm text-gray-700 dark:text-gray-300 whitespace-nowrap">
      1 / 1
    </div>

    <button type="button"
            data-action="click->pdf-preview#nextPage"
            class="px-2 md:px-3 py-1 text-sm bg-gray-100 dark:bg-gray-700 active:bg-gray-300 dark:active:bg-gray-600 hover:bg-gray-200 dark:hover:bg-gray-600 rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed touch-manipulation"
            title="下一页">
      <i class="ri-arrow-right-line"></i>
    </button>

    <div class="w-px h-4 md:h-6 bg-gray-300 dark:bg-gray-600 mx-0.5 md:mx-1"></div>

    <button type="button"
            data-action="click->pdf-preview#zoomOut"
            class="px-2 md:px-3 py-1 text-sm bg-gray-100 dark:bg-gray-700 active:bg-gray-300 dark:active:bg-gray-600 hover:bg-gray-200 dark:hover:bg-gray-600 rounded transition-colors touch-manipulation"
            title="缩小">
      <i class="ri-zoom-out-line"></i>
    </button>

    <button type="button"
            data-action="click->pdf-preview#resetZoom"
            class="px-1.5 md:px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 active:bg-gray-300 dark:active:bg-gray-600 hover:bg-gray-200 dark:hover:bg-gray-600 rounded transition-colors touch-manipulation"
            title="重置缩放">
      <span class="hidden md:inline whitespace-nowrap">重置</span>
      <span class="md:hidden">0</span>
    </button>

    <button type="button"
            data-action="click->pdf-preview#zoomIn"
            class="px-2 md:px-3 py-1 text-sm bg-gray-100 dark:bg-gray-700 active:bg-gray-300 dark:active:bg-gray-600 hover:bg-gray-200 dark:hover:bg-gray-600 rounded transition-colors touch-manipulation"
            title="放大">
      <i class="ri-zoom-in-line"></i>
    </button>
  </div>
</div>
