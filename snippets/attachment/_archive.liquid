{% comment %} 压缩包资源详情展示 {% endcomment %}
<div class="grid grid-cols-1 lg:grid-cols-7 gap-6 mb-8">
  <!-- Left Column - Archive Preview (2/3 width) -->
  <div class="lg:col-span-3">
    <div class="space-y-4 sticky top-6">
      <div class="bg-gray-100 dark:bg-gray-800 rounded-lg overflow-hidden shadow flex items-center justify-center h-[20vh] md:min-h-[400px] md:h-[calc(100vh-300px)] relative" data-controller="images-viewer" x-data="{ openViewer: function() { this.$refs['images-viewer']?.click() } }">
        {% if page.settings.cover %}
          <img src="{{ page.settings.cover }}"
               alt="{{ page.link_text }}"
               x-ref="images-viewer"
               class="max-w-full max-h-full object-contain">
        {% else %}
          <div class="flex flex-col items-center justify-center text-gray-400 dark:text-gray-500">
            <i class="ri-file-zip-line text-6xl mb-2"></i>
            <p>{{ "snippets.attachment.common.no_preview" | t: "暂无预览" }}</p>
          </div>
        {% endif %}
      </div>

      <div class="flex items-start gap-2 border-b border-gray-100 pb-4 md:mb-4">
        <div class="flex flex-col gap-2">
          <div class="font-medium text-2xl leading-tight">{{ page.settings.title }}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Column - Resource Details Card (1/3 width) -->
  <div class="lg:col-span-4">
    <div class="space-y-4">
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
        <!-- Title Section -->
        <div class="flex items-center gap-2 border-b border-gray-100 pb-4 mb-4">
          <i class="ri-price-tag-3-line text-primary"></i>
          <span class="font-medium">{{ "snippets.attachment.common.metadata" | t: "文件元数据" }}</span>
        </div>

        <!-- Metadata Section -->
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div class="flex items-center gap-2">
            <div class="w-[36px] h-[36px] rounded-sm bg-gray-100 flex justify-center items-center">
              <i class="ri-hard-drive-line"></i>
            </div>
            <div class="flex flex-col space-y-0.1">
              <span class="text-[12px] text-base-content/50">{{ "snippets.attachment.common.file_size" | t: "文件大小" }}</span>
              <span class="font-bold">
                {{ entity.metadata.human_size }}
              </span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-[36px] h-[36px] rounded-sm bg-gray-100 flex justify-center items-center">
              <i class="ri-file-zip-line"></i>
            </div>
            <div class="flex flex-col space-y-0.1">
              <span class="text-[12px] text-base-content/50">{{ "snippets.attachment.common.file_type" | t: "文件类型" }}</span>
              <span class="font-bold">
                {% if entity.metadata.kind %}
                  {{ entity.metadata.kind }}
                {% elsif entity.metadata.content_type %}
                  {{ entity.metadata.content_type | split: '/' | last }}
                {% endif %}
              </span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-[36px] h-[36px] rounded-sm bg-gray-100 flex justify-center items-center">
              <i class="ri-calendar-check-line"></i>
            </div>
            <div class="flex flex-col space-y-0.1">
              <span class="text-[12px] text-base-content/50">{{ "snippets.attachment.common.uploaded_at" | t: "上传时间" }}</span>
              <span class="font-bold">{{ page.published_at | date:
              "%Y-%m-%d" }}</span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-[36px] h-[36px] rounded-sm bg-gray-100 flex justify-center items-center">
              <i class="ri-eye-line"></i>
            </div>
            <div class="flex flex-col space-y-0.1">
              <span class="text-[12px] text-base-content/50">{{ "snippets.attachment.common.visits_count" | t: "浏览次数" }}</span>
              <span class="font-bold">
                {{ page.visits_count }}
              </span>
            </div>
          </div>
          {% if page.author and page.author.name %}
            <div class="flex items-center gap-2">
              <div class="w-[36px] h-[36px] rounded-sm bg-gray-100 flex justify-center items-center">
                <i class="ri-user-line"></i>
              </div>
              <div class="flex flex-col space-y-0.1">
                <span class="text-[12px] text-base-content/50">{{ "snippets.attachment.common.creator" | t: "创建者" }}</span>
                <span class="font-bold">{{ page.author.name }}</span>
              </div>
            </div>
          {% elsif page.settings.creator %}
            <div class="flex items-center gap-2">
              <div class="w-[36px] h-[36px] rounded-sm bg-gray-100 flex justify-center items-center">
                <i class="ri-user-line"></i>
              </div>
              <div class="flex flex-col space-y-0.1">
                <span class="text-[12px] text-base-content/50">{{ "snippets.attachment.common.creator" | t: "创建者" }}</span>
                <span class="font-bold">{{ page.settings.creator }}</span>
              </div>
            </div>
          {% endif %}
        </div>

        <!-- Action Buttons -->
        <div class="text-center max-w-50 block">
          {% render 'attachment/download_btn', entity: entity, page: page %}
        </div>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
        <div class="flex items-center gap-2 border-b border-gray-100 pb-4 mb-4">
          <i class="ri-price-tag-3-line text-primary"></i>
          <span class="font-medium">{{ "snippets.attachment.common.tags" | t: "文件标签" }}</span>
        </div>
        <div class="flex flex-wrap gap-2 min-h-9">
          {% for tag in page.settings.resource_tags %}
            <span class="inline-flex items-center px-3 py-1 bg-primary/10 text-primary/80 rounded text-sm">{{ tag.name }}</span>
          {% endfor %}
        </div>
      </div>

      <!-- Resource Description -->
      {% assign has_content = page.settings.content | replace: '<p></p>', '' | present? %}
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
          <div class="flex items-center gap-2 border-b border-gray-100 pb-4 mb-4">
            <i class="ri-article-line text-primary"></i>
            <span class="font-medium">{{ "snippets.attachment.common.description" | t: "文件描述" }}</span>
          </div>
          <section
            class="ProseMirror prose prose-sm max-w-none dark:prose-invert prose-headings:mt-4 prose-headings:mb-2 prose-p:my-2 prose-ul:my-2 prose-ol:my-2 prose-li:my-1 prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-img:rounded-lg prose-img:my-4 min-h-9"
            data-controller="link-target images-viewer">
            {{ page.settings.content }}
          </section>
        </div>
    </div>
  </div>
</div>
