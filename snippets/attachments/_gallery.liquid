{% comment %}
  画廊网格：仅展示预览图，无标题/标签/大小/日期。
  Smart Cover：统一 1:1 格子；同图 blur 铺底 + 前景 object-contain。
  卡片带 data-gallery-*，供 lightbox 收集当前列表。
{% endcomment %}
<div
  id="gallery-grid"
  class="grid bg-base-200 p-1 [--gallery-base-min:8rem] sm:[--gallery-base-min:9rem] md:[--gallery-base-min:10rem] lg:[--gallery-base-min:11rem] xl:[--gallery-base-min:12rem]"
  style="
    --gallery-gap: clamp(0.15rem, calc(0.25rem * var(--view-zoom, 1)), 0.75rem);
    --gallery-min-size: clamp(5.5rem, calc(var(--gallery-base-min, 9rem) * var(--view-zoom, 1)), 18rem);
    grid-template-columns: repeat(auto-fill, minmax(var(--gallery-min-size), 1fr));
    gap: var(--gallery-gap);
  "
  data-attachments-list
  data-gallery-pagination
>
  {% assign has_any_item = false %}

  {% for item in folder_pages %}
    {% assign has_any_item = true %}
    {% assign folder_title = item.settings.title | default: item.link_text %}
    {% assign folder_thumb = item.settings.thumb_url | presence %}
    <a
      href="{{ site.index_path }}?channel={{ item.full_slug }}"
      class="gallery-card relative isolate aspect-square overflow-hidden bg-amber-50 cursor-pointer group block"
      @click.prevent.stop="updateChannel('{{ item.full_slug }}'); if (typeof handleSidebarClick === 'function') handleSidebarClick();"
    >
      {% if folder_thumb %}
        <img
          src="{{ folder_thumb }}"
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full scale-125 object-cover blur-2xl opacity-40"
          loading="lazy"
          decoding="async"
        >
        <img
          src="{{ folder_thumb }}"
          alt="{{ folder_title | escape }}"
          class="relative z-10 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        >
      {% else %}
        <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-amber-500/80">
          <i class="ri-folder-6-fill text-4xl"></i>
          <span class="px-2 text-center text-xs font-medium text-base-content/70 line-clamp-2">{{ folder_title }}</span>
        </div>
      {% endif %}
      <span class="absolute bottom-1.5 left-1.5 z-20 rounded bg-amber-500/90 px-1.5 py-0.5 text-[0.65rem] font-medium text-white">
        {{ "snippets.attachments.grid.file_types.folder" | t: "文件夹" }}
      </span>
    </a>
  {% endfor %}

  {% for item in filtered_pages %}
    {% assign has_any_item = true %}
    {% assign entity = item.settings.asset %}
    {% assign can_access = item | can_access? %}
    {% assign _detail_open_mode = detail_open_mode | default: 'detail_page' %}

    {% assign thumb_url = '' %}
    {% assign preview_url = '' %}
    {% if entity and entity.previewable? %}
      {% assign thumb_url = entity.preview.thumb | default: entity.preview.cover %}
      {% assign preview_url = entity.preview.cover | default: entity.preview.thumb %}
    {% elsif entity and entity.image? and entity.metadata.content_type == 'image/svg+xml' %}
      {% assign preview_url = entity.url[site.settings.resource_download_expiry_time] %}
      {% assign thumb_url = preview_url %}
    {% elsif item.settings.cover %}
      {% assign preview_url = item.settings.cover %}
      {% assign thumb_url = item.settings.cover %}
    {% endif %}

    {% assign _thumb_src = thumb_url | default: preview_url %}

    {% if _detail_open_mode == 'modal' %}
      <button
        type="button"
        id="item-{{ item.full_slug | replace: '/', '-' | replace: '.', '-' }}"
        class="gallery-card relative isolate aspect-square overflow-hidden bg-base-300 cursor-pointer group border-0 p-0 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        data-gallery-item
        data-full-slug="{{ item.full_slug | escape }}"
        data-title="{{ item.link_text | escape }}"
        data-url="{{ item.url | escape }}"
        data-preview="{{ preview_url | escape }}"
        data-thumb="{{ thumb_url | escape }}"
        @click.prevent.stop="$dispatch('open-detail', {
          full_slug: $el.dataset.fullSlug,
          title: $el.dataset.title,
          url: $el.dataset.url,
          preview: $el.dataset.preview,
          thumb: $el.dataset.thumb
        })"
      >
        {% if _thumb_src != blank %}
          <img
            src="{{ _thumb_src }}"
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full scale-125 object-cover blur-2xl opacity-60"
            loading="lazy"
            decoding="async"
          >
          <img
            src="{{ _thumb_src }}"
            alt=""
            class="relative z-10 h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          >
        {% else %}
          <div class="flex h-full w-full items-center justify-center text-base-content/40">
            {% if entity and entity.video? %}
              <i class="ri-video-line text-3xl"></i>
            {% elsif entity and entity.audio? %}
              <i class="ri-music-2-line text-3xl"></i>
            {% elsif entity and entity.pdf? %}
              <i class="ri-file-pdf-line text-3xl"></i>
            {% else %}
              <i class="ri-file-line text-3xl"></i>
            {% endif %}
          </div>
        {% endif %}
        {% unless can_access %}
          <span class="absolute top-1.5 right-1.5 z-20 flex size-6 items-center justify-center rounded-full bg-warning text-warning-content shadow-sm">
            <i class="ri-lock-2-line text-xs"></i>
          </span>
        {% endunless %}
      </button>
    {% else %}
      <a
        id="item-{{ item.full_slug | replace: '/', '-' | replace: '.', '-' }}"
        href="{{ item.url }}"
        data-turbo="false"
        class="gallery-card relative isolate aspect-square overflow-hidden bg-base-300 cursor-pointer group block"
        data-gallery-item
        data-full-slug="{{ item.full_slug | escape }}"
        data-title="{{ item.link_text | escape }}"
        data-url="{{ item.url | escape }}"
        data-preview="{{ preview_url | escape }}"
        data-thumb="{{ thumb_url | escape }}"
      >
        {% if _thumb_src != blank %}
          <img
            src="{{ _thumb_src }}"
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full scale-125 object-cover blur-2xl opacity-60"
            loading="lazy"
            decoding="async"
          >
          <img
            src="{{ _thumb_src }}"
            alt=""
            class="relative z-10 h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          >
        {% else %}
          <div class="flex h-full w-full items-center justify-center text-base-content/40">
            <i class="ri-file-line text-3xl"></i>
          </div>
        {% endif %}
        {% unless can_access %}
          <span class="absolute top-1.5 right-1.5 z-20 flex size-6 items-center justify-center rounded-full bg-warning text-warning-content shadow-sm">
            <i class="ri-lock-2-line text-xs"></i>
          </span>
        {% endunless %}
      </a>
    {% endif %}
  {% endfor %}

  {% unless has_any_item or append_mode %}
    <div class="col-span-full w-full py-12 bg-base-100 rounded-lg" data-attachments-empty>
      <div class="text-center">
        <i class="ri-folder-open-line text-6xl text-base-content/30 mb-4"></i>
        <p class="text-base-content/70 text-lg">{{ "snippets.attachments.empty.title" | t: "暂无文件" }}</p>
        <p class="text-base-content/50 text-sm mt-2">{{ "snippets.attachments.empty.description" | t: "当前筛选条件下没有找到任何资源" }}</p>
      </div>
    </div>
  {% endunless %}
</div>
