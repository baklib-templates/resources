{% comment %} 压缩包类型模板 {% endcomment %}
<div class="aspect-square bg-yellow-50 dark:bg-yellow-900/20 flex items-center justify-center relative overflow-hidden">
  {% if entity.previewable? %}
    <img src="{{ entity.preview.cover }}" alt="{{ item.link_text }}"
      class="w-full h-full object-cover">
  {% else %}
    <div class="absolute inset-0 flex items-center justify-center">
      <i class="ri-file-zip-line text-5xl text-yellow-500"></i>
    </div>
  {% endif %}
  <div class="absolute top-2 right-2 px-2 py-1 bg-yellow-500 text-white text-xs rounded font-semibold">
    ZIP
  </div>
</div>
<div class="p-2 item-name">
  <p class="text-xs text-gray-600 dark:text-gray-400 truncate">{{ item.link_text }}</p>
  {% if entity and entity.metadata.human_size %}
    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">{{ entity.metadata.human_size }}</p>
  {% endif %}
</div>

