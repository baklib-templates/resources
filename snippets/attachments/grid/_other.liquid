{% comment %} 其他文件类型模板 {% endcomment %}
<div class="relative aspect-video bg-gray-200 overflow-hidden">
  {% if entity and entity.previewable? %}
    <img src="{{ entity.preview.cover }}" alt="{{ item.link_text }}"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
  {% else %}
    <div class="w-full h-full flex items-center justify-center">
      <i class="ri-file-line text-4xl text-gray-400"></i>
    </div>
  {% endif %}
  <div class="absolute top-2 right-2 px-2 py-1 bg-gray-500 text-white text-(length:--grid-badge-size) rounded font-semibold shadow-sm">
    {{ "snippets.attachments.grid.file_types.other" | t: "其他" }}
  </div>
</div>

<div class="p-4 flex flex-col flex-1 space-y-2">
  <p class="font-medium text-(length:--grid-title-size) line-clamp-1 truncate flex items-center gap-1.5">
    {% unless can_access %}
      <i class="ri-lock-2-line text-warning shrink-0"></i>
    {% endunless %}
    {{ item.link_text }}
  </p>
  <div class="flex overflow-hidden whitespace-nowrap items-center text-(length:--grid-meta-size) text-base-content/60">
    {% if entity and entity.metadata.human_size %}
      <div class="">{{ entity.metadata.human_size }}</div>
      <div class='bg-gray-300 w-[1.5px] h-[15px] mx-2'></div>
    {% elsif item.settings.file_size %}
      <div class="">{{ item.settings.file_size }}</div>
      <div class='bg-gray-300 w-[1.5px] h-[15px] mx-2'></div>
    {% endif %}
    <div>
      {{ item.published_at | date: "%Y-%m-%d" }}
    </div>
  </div>

  <!-- Tags -->
  {% if item.settings.resource_tags.size > 0 %}
    <div class="overflow-x-auto w-full">
      <div class="flex flex-row space-x-2 whitespace-nowrap">
        {% for tag in item.settings.resource_tags %}
          <div class="px-2.5 py-1 bg-gray-100 text-gray-500 text-(length:--grid-tag-size) rounded font-normal">
            <span class="line-clamp-1">{{ tag.name }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

