{% comment %} 其他文件类型模板 {% endcomment %}
<div class="aspect-square bg-gray-200 dark:bg-gray-700 flex items-center justify-center relative overflow-hidden">
  {% if entity and entity.previewable? %}
    <img src="{{ entity.preview.cover }}" alt="{{ item.link_text }}"
      class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300">
  {% else %}
    <div class="w-full h-full flex items-center justify-center">
      <i class="ri-file-line text-4xl text-gray-400"></i>
    </div>
  {% endif %}
  <div class="absolute top-2 right-2 px-2 py-1 bg-primary text-white text-xs rounded font-semibold shadow-sm">
    其他
  </div>
</div>
<div class="p-2 item-name">
  <p class="text-xs text-gray-600 dark:text-gray-400 truncate">{{ item.link_text }}</p>
  {% if entity and entity.metadata.human_size %}
    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">{{ entity.metadata.human_size }}</p>
  {% elsif item.settings.file_size %}
    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">{{ item.settings.file_size }}</p>
  {% endif %}
</div>

