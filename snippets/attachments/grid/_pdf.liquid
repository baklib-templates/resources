{% comment %} PDF类型模板 {% endcomment %}
<div class="aspect-square overflow-hidden bg-red-50 dark:bg-red-900/20 relative">
  {% if entity.previewable? %}
    <img src="{{ entity.preview.cover }}" alt="{{ item.link_text }}"
      class="w-full h-full object-cover">
  {% else %}
    <div class="w-full h-full flex items-center justify-center">
      <i class="ri-file-pdf-line text-5xl text-red-500"></i>
    </div>
  {% endif %}
  <div class="absolute top-2 right-2 px-2 py-1 bg-red-500 text-white text-xs rounded font-semibold">
    PDF
  </div>
</div>
<div class="p-2 item-name">
  <p class="text-xs text-gray-600 dark:text-gray-400 truncate">{{ item.link_text }}</p>
  {% if entity and entity.metadata.human_size %}
    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">{{ entity.metadata.human_size }}</p>
  {% endif %}
</div>

