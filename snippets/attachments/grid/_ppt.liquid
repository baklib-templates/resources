{% comment %} PPT类型模板 {% endcomment %}
<div class="relative aspect-video bg-gray-200 overflow-hidden">
  {% if entity.previewable? %}
    <img src="{{ entity.preview.cover }}" alt="{{ item.link_text }}"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
  {% else %}
    <div class="absolute inset-0 flex items-center justify-center">
      <i class="ri-file-ppt-line text-5xl text-orange-500"></i>
    </div>
  {% endif %}
  <div class="absolute top-2 right-2 px-2 py-1 bg-orange-500 text-white text-xs rounded font-semibold shadow-sm">
    PPT
  </div>
</div>

<div class="p-4 flex flex-col flex-1 space-y-2">
  <p class="font-medium text-sm line-clamp-1 truncate">{{ item.link_text }}</p>
  <div class="flex overflow-hidden whitespace-nowrap items-center text-base-content/60">
    {% if entity and entity.metadata.human_size %}
      <div class="">{{ entity.metadata.human_size }}</div>
      <div class='bg-gray-300 w-[1.5px] h-[15px] mx-2'></div>
    {% endif %}
    <div>
      {{ item.published_at | date: "%Y-%m-%d" }}
    </div>
  </div>

  <!-- Tags -->
  {% if item.settings.resource_tags.size > 0 %}
    <div class="overflow-x-scroll w-full">
      <div class="flex flex-row space-x-2 whitespace-nowrap">
        {% for tag in item.settings.resource_tags %}
          <div class="px-2.5 py-1 bg-gray-100 text-gray-500 rounded font-normal">
            <span class="line-clamp-1">{{ tag.name }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

