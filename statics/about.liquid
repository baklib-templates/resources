{% layout 'theme_no_content' %}
<pre>
预设样式列表：
- header default: https://daisyui.com/components/header/
- footer default: https://daisyui.com/components/footer/
- hero carousel: https://daisyui.com/components/hero/
- hero 2 carousel: https://daisyui.com/components/hero/
- hero 3 carousel: https://daisyui.com/components/hero/
- hero 4 content: https://tailwindcss.com/plus/ui-blocks/marketing/sections/heroes
</pre>

<section class="preset-section rounded-lg shadow-sm border border-base-300 px-6 py-8 md:px-10 md:py-10">
  <!-- header default: https://daisyui.com/components/header/ -->
  <main>
    <div class="relative" data-controller="more-menu">
      <button
        type="button"
        class="rounded-md p-2 text-gray-600 transition-colors hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700"
        data-action="click-&gt;more-menu#toggle"
        title="Menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-6 h-6 w-6"
        >
          <path
            d="M11.644 1.59a.75.75 0 0 1 .712 0l9.75 5.25a.75.75 0 0 1 0 1.32l-9.75 5.25a.75.75 0 0 1-.712 0l-9.75-5.25a.75.75 0 0 1 0-1.32l9.75-5.25Z"
          />
          <path
            d="m3.265 10.602 7.668 4.129a2.25 2.25 0 0 0 2.134 0l7.668-4.13 1.37.739a.75.75 0 0 1 0 1.32l-9.75 5.25a.75.75 0 0 1-.71 0l-9.75-5.25a.75.75 0 0 1 0-1.32l1.37-.738Z"
          />
          <path
            d="m10.933 19.231-7.668-4.13-1.37.739a.75.75 0 0 0 0 1.32l9.75 5.25c.221.12.489.12.71 0l9.75-5.25a.75.75 0 0 0 0-1.32l-1.37-.738-7.668 4.13a2.25 2.25 0 0 1-2.134-.001Z"
          />
        </svg>
      </button>
      <div
        class="absolute right-0 z-50 mt-2 hidden w-48 rounded-md border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-800"
        data-more-menu-target="menu"
      >
        <div class="py-1">
          <a
            href="/-/search"
            class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
          >
            <i class="ri-search-line"></i>
            <span>全站搜索</span>
          </a>
          <a
            href="/"
            class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
          >
            <i class="ri-link"></i>
            <span>首页</span>
          </a>

          <a
            href="/s/about"
            class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
          >
            <i class="ri-link"></i>
            <span> 关于本站</span>
          </a>

          <a
            href="https://www.baklib.com"
            class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
          >
            <i class="ri-link"></i>
            <span>操作教程</span>
          </a>
        </div>
      </div>
    </div>

  </main>
</section>

<section class="preset-section rounded-lg shadow-sm border border-base-300 px-6 py-8 md:px-10 md:py-10">
  <!-- footer default: https://daisyui.com/components/footer/ -->
  <main>
    <div class="mx-auto items-center justify-between sm:flex-row">
