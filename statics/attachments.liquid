{% layout none %}

{% assign sort = params.sort %}
{% assign view_mode = params.view | default: 'grid' %}
{% assign is_append = false %}
{% if params.append == '1' or params.append == 'true' %}
  {% assign is_append = true %}
{% endif %}
{% if site.pages['/'].settings.detail_open_mode %}
  {% assign detail_open_mode = 'detail_page' %}
{% else %}
  {% assign detail_open_mode = 'modal' %}
{% endif %}
{% unless view_mode == 'list' or view_mode == 'gallery' %}
  {% assign view_mode = 'grid' %}
{% endunless %}
{% comment %} 100MB {% endcomment %}
{% assign file_limit = 104857600 %}

{% comment %} 计算文件大小范围（MB转字节） {% endcomment %}
{% assign has_size_min = false %}
{% assign has_size_max = false %}
{% if params.size_min %}
  {% assign size_min_bytes = params.size_min | times: 1048576 %}
  {% assign has_size_min = true %}
{% endif %}
{% if params.size_max %}
  {% assign size_max_bytes = params.size_max | times: 1048576 %}
  {% assign has_size_max = true %}
{% endif %}

{% comment %} 定义查询条件变量 {% endcomment %}
{% assign any_string = params.any_string %}
{% assign file_type = params.file_type %}
{% if params.channel %}
  {% assign parent_page = site.pages[params.channel] %}
  {% assign base_pages = parent_page.children_in_list %}
{% else %}
  {% assign parent_page = site.pages['/'] %}
  {% assign base_pages = site.pages_in_list %}
{% endif %}

{% comment %}
  当前目录下的子栏目 → 文件夹（Finder / 资源管理器语义）。
  关键词搜索、追加加载（第 2 页起）不混入文件夹。
{% endcomment %}
{% assign folder_pages = parent_page.children_in_nav_menu | where: 'template_name', 'channel' %}
{% if params.search_q != blank or is_append %}
  {% assign folder_pages = nil %}
{% endif %}

{% comment %} params.date_start = '2026-01-28' => "2026-01-28 00:00:00" {% endcomment %}
{% assign date_start = params.date_start | date: '%Y-%m-%d 00:00:00' %}
{% assign date_end = params.date_end | date: '%Y-%m-%d 23:59:59' %}

{% query filtered_pages from base_pages %}
  {
    "where": {
      "template_name_eq": "page",
      "settings.asset.metadata.kind_in": file_type,
      "settings.asset.metadata.size_gteq": size_min_bytes,
      "settings.asset.metadata.size_lteq": size_max_bytes,
      "settings.resource_tags_array_cont_any": params.resource_tags,
      "settings.resource_types_array_cont_any": params.resource_types,
      "published_at_gteq": date_start,
      "published_at_lteq": date_end
    }
  }
{% endquery %}

<turbo-frame id="attachments_frame">
  {% search filtered_pages, keywords: params.search_q, by_user: true, allow_empty_keywords: true %}
    {% if sort %}
      {% assign search_pages = search.pages | order_by: sort %}
    {% else %}
      {% assign search_pages = search.pages %}
    {% endif %}

    {% paginate_tag search_pages, per: 50 %}
      {% if is_append %}
        {% comment %} 仅返回本页条目，供滚动追加 {% endcomment %}
        <div data-infinite-scroll-page>
          {% if view_mode == 'list' %}
            {% render 'attachments/list', filtered_pages: search_pages, folder_pages: nil, detail_open_mode: detail_open_mode, append_mode: true %}
          {% elsif view_mode == 'gallery' %}
            {% render 'attachments/gallery', filtered_pages: search_pages, folder_pages: nil, detail_open_mode: detail_open_mode, paginate: paginate, append_mode: true %}
          {% else %}
            {% render 'attachments/grid', filtered_pages: search_pages, folder_pages: nil, detail_open_mode: detail_open_mode, append_mode: true %}
          {% endif %}
          {% render 'attachments/infinite_scroll_sentinel', paginate: paginate %}
        </div>
      {% else %}
        <div
          class="flex flex-col w-full min-w-0"
          data-image-zoom-target="view"
          style="--view-zoom: 1; --zoom-font: 1; --zoom-thumb: 1;"
          x-cloak
        >
          {% render 'attachments/folder_breadcrumb', parent_page: parent_page, channel: params.channel %}

          <div class="flex-1">
            {% if view_mode == 'list' %}
              {% render 'attachments/list', filtered_pages: search_pages, folder_pages: folder_pages, detail_open_mode: detail_open_mode %}
            {% elsif view_mode == 'gallery' %}
              {% render 'attachments/gallery', filtered_pages: search_pages, folder_pages: folder_pages, detail_open_mode: detail_open_mode, paginate: paginate %}
            {% else %}
              {% render 'attachments/grid', filtered_pages: search_pages, folder_pages: folder_pages, detail_open_mode: detail_open_mode %}
            {% endif %}
          </div>

          {% render 'attachments/infinite_scroll_sentinel', paginate: paginate %}
        </div>
      {% endif %}
    {% endpaginate_tag %}
  {% endsearch %}
</turbo-frame>
