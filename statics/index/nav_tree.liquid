{% layout none %}

{% assign parent_path = params.parent_path | default: '/' %}
<turbo-frame id="index_nav_tree_frame_{{ parent_path | replace: '/', '_' }}" class='w-full'>
  {% assign page1 = site.pages[parent_path] %}
  {% assign nav_tree = page1 | nav_tree: 1, template_name: 'channel' %}
  {% assign depth = params.depth | presence | default: page1.depth %}

  {% if params.root %}
    {% comment %} 顶部添加一个固定的："全部资源" {% endcomment %}
    {% assign channel = params.channel | default: '' %}
    {% assign is_all_resources_active = false %}
    {% if channel == '' or channel == '/' %}
      {% assign is_all_resources_active = true %}
    {% endif %}
    <li{% if is_all_resources_active %} active{% endif %}>
      <div
        turbo-nav-tree-item
        {% if is_all_resources_active %}active{% endif %}
        class="grid grid-cols-[1fr_auto] px-4 hover:bg-base-200 w-full whitespace-nowrap text-base-content break-all group transition-colors duration-150 rounded-md"
        style="padding-left: calc((var(--spacing) * 4) + 0 * 1rem)"
      >
        <div
          data-breadcrumb-target="navNode"
          data-node-path="/"
          data-node-name="全部资源"
          @click="
            updateChannel('');
            handleSidebarClick();
            const turboFrame = $el.closest('turbo-frame');
            if (turboFrame) {
              turboFrame.querySelectorAll('[active]').forEach(el => el.removeAttribute('active'));
              const li = $el.closest('li');
              if (li) {
                li.setAttribute('active', '');
                const item = li.querySelector('[turbo-nav-tree-item]');
                if (item) {
                  item.setAttribute('active', '');
                }
              }
            }
          "
          class="flex py-3 space-x-2 items-center cursor-pointer"
        >
          <!-- 文件夹图标 -->
          <div class="flex items-center justify-center w-4 h-4 shrink-0">
            <i class="ri-folder-open-fill inline-flex items-center justify-center w-5 h-5"></i>
          </div>
          <!-- 文本内容 -->
          <span
            class="line-clamp-2 flex-1 nav-tree-channel-item text-sm leading-relaxed"
          >
            全部资源
          </span>
        </div>
      </div>
    </li>
  {% endif %}
  <div
    data-controller="turbo-nav-tree"
    data-turbo-nav-tree-nav-tree-value='{{ nav_tree | to_json | escape }}'
    data-turbo-nav-tree-depth-value='{{ depth }}'
    data-turbo-nav-tree-current-path-value='{{ params.channel }}'
    data-turbo-nav-tree-root-container-value=".custom-menu"
    data-turbo-nav-tree-parent-path-value='{{ parent_path }}'
    data-turbo-nav-tree-url-value='/s/index/nav_tree?channel={{ params.channel }}'
    data-turbo-nav-tree-id-prefix-value='index_nav_tree_frame_'
  >
    <template data-turbo-nav-tree-target="itemTemplate">
      {% raw %}
        {{#hasChildren}}
          <div
            class="grid grid-cols-[1fr_auto] px-4 hover:bg-base-200 w-full whitespace-nowrap text-base-content break-all group transition-colors duration-150 rounded-md"
            style="padding-left: calc((var(--spacing) * 4) + {{depth}} * 1rem)"
          >
            <div
              data-action="click->turbo-nav-tree#click"
              data-breadcrumb-target="navNode"
              data-node-path="{{path}}"
              data-node-name="{{link_text}}"
              @click="updateChannel('{{path}}'); handleSidebarClick()"
              class="flex py-3 space-x-2 items-center cursor-pointer"
            >
              <!-- 文件夹图标 -->
              <div class="flex items-center justify-center w-4 h-4 shrink-0">
                <i class="ri-folder-open-fill inline-flex items-center justify-center w-5 h-5"></i>
              </div>
              <!-- 文本内容 -->
              <span class="line-clamp-2 flex-1 nav-tree-channel-item text-sm leading-relaxed">
                {{link_text}}
              </span>
            </div>
            <!-- 展开/折叠指示器 -->
            <div data-action="click->turbo-nav-tree#toggle" class="flex items-center justify-center px-2">
              <div turbo-nav-tree-item-target-icon class="flex items-center justify-center w-4 transition-transform duration-200 {{#open}}rotate-90{{/open}} cursor-pointer">
                <svg class="w-5 h-5 transition-colors duration-150" fill="none" stroke="currentColor" stroke-width="2.5"
                  viewBox="0 0 24 24">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </div>
            </div>
          </div>
        {{/hasChildren}}
        {{^hasChildren}}
          <div
            class="grid grid-cols-[1fr_auto] px-4 hover:bg-base-200 w-full whitespace-nowrap text-base-content break-all group transition-colors duration-150 rounded-md"
            style="padding-left: calc((var(--spacing) * 4) + {{depth}} * 1rem)"
          >
            <div
              data-action="click->turbo-nav-tree#click"
              data-breadcrumb-target="navNode"
              data-node-path="{{path}}"
              data-node-name="{{link_text}}"
              @click="updateChannel('{{path}}'); handleSidebarClick()"
              class="flex py-3 space-x-2 items-center cursor-pointer"
            >
              <!-- 文件夹图标 -->
              <div class="flex items-center justify-center w-4 h-4 shrink-0">
                <i class="ri-folder-open-fill inline-flex items-center justify-center w-5 h-5"></i>
              </div>
              <!-- 文本内容 -->
              <span
                class="line-clamp-2 flex-1 nav-tree-channel-item text-sm leading-relaxed"
              >
                {{link_text}}
              </span>
            </div>
          </div>
        {{/hasChildren}}
      {% endraw %}
    </template>
  </div>
</turbo-frame>
