{% schema %}
{
  "name": "t:schema.templates.channel.name",
  "description": "t:schema.templates.channel.description",
  "thumb_url": "images/theme/${lang}/channel.png",
  "preview_image_urls": [
    "images/theme/${lang}/channel.png"
  ],
  "sub_page_templates": ["page","channel"],
  "settings": [
    {
      "id": "title",
      "type": "text",
      "label": "t:schema.templates.channel.settings.title.label"
    },
    {
      "id": "description",
      "type": "textarea",
      "label": "t:schema.templates.channel.settings.description.label",
      "info": "t:schema.templates.channel.settings.description.info"
    },
    {
      "id": "thumb_url",
      "type": "image_picker",
      "ratio": "16:9",
      "width": 400,
      "label": "t:schema.templates.channel.settings.thumb_url.label",
      "info": "t:schema.templates.channel.settings.thumb_url.info"
    }
  ]
}
{% endschema %}

{% layout 'theme_no_content' %}

<div
  data-controller="redirect"
  data-redirect-target-url-value="{{ site.index_path }}"
  data-redirect-params-value='{"channel": "{{ page.full_slug }}"}'
  data-redirect-use-current-url-value="true"
  data-redirect-override-value="false"
  data-redirect-keep-history-value="false"
  class="fixed inset-0 bg-white bg-opacity-50 flex items-center justify-center"
>
  <span class="loading loading-spinner loading-md"></span>
</div>
