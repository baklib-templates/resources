{% schema %}
{
  "name": "t:schema.templates.channel.name",
  "description": "t:schema.templates.channel.description",
  "thumb_url": "images/theme/${lang}/channel.png",
  "preview_image_urls": [
    "images/theme/${lang}/channel.png"
  ],
  "sub_page_templates": ["page","channel"],
  "settings": [
    {
      "id": "title",
      "type": "text",
      "label": "t:schema.templates.channel.settings.title.label"
    },
    {
      "id": "description",
      "type": "textarea",
      "label": "t:schema.templates.channel.settings.description.label",
      "info": "t:schema.templates.channel.settings.description.info"
    },
    {
      "id": "thumb_url",
      "type": "image_picker",
      "ratio": "16:9",
      "width": 400,
      "label": "t:schema.templates.channel.settings.thumb_url.label",
      "info": "t:schema.templates.channel.settings.thumb_url.info"
    }
  ]
}
{% endschema %}

{% comment %}
  栏目页与首页共用门户壳；URL 为栏目 path（如 /media?view=grid），
  门户设置读取首页；展示风格跟随首页 template_style。
{% endcomment %}
{% assign index_page = site.pages['/'] %}
{% if index_page.template_style == 'gallery' %}
  {% render 'index/portal_gallery', channel_slug: page.full_slug, settings_page: index_page %}
{% else %}
  {% render 'index/portal_default', channel_slug: page.full_slug, settings_page: index_page %}
{% endif %}
