{% schema %}
  {
    "name": "t:schema.templates.index.gallery.name",
    "description": "t:schema.templates.index.gallery.description",
    "thumb_url": "images/theme/${lang}/index.png",
    "preview_image_urls": [
      "images/theme/${lang}/index.png"
    ],
    "sub_page_templates": ["channel"],
    "settings": [
      {
        "id": "detail_open_mode",
        "type": "checkbox",
        "label": "t:schema.templates.index.settings.detail_open_mode.label",
        "info": "t:schema.templates.index.settings.detail_open_mode.info",
        "default": false
      },
      {
        "id": "show_channel_section",
        "type": "checkbox",
        "label": "t:schema.templates.index.settings.show_channel_section.label",
        "info": "t:schema.templates.index.settings.show_channel_section.info",
        "default": false
      },
      {
        "id": "hero_html",
        "type": "html",
        "label": "t:schema.templates.index.settings.hero_html.label",
        "info": "t:schema.templates.index.settings.hero_html.info",
        "rows": 24,
        "default": "preset:hero.html"
      }

    ]
  }
{% endschema %}

{% render 'index/portal_gallery', channel_slug: '', settings_page: page %}
