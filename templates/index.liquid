{% schema %}
  {
    "name": "t:schema.templates.index.name",
    "description": "t:schema.templates.index.description",
    "thumb_url": "images/theme/index.png",
    "sub_page_templates": ["channel", "page"]
  }
{% endschema %}

{% assign channel = params.channel | default: '/' %}
{% assign defaultBreadcrumb = site.pages[channel].breadcrumb | default: [] %}

<div
  class="flex-1 flex min-h-0 overflow-hidden"
  data-controller="breadcrumb"
  data-breadcrumb-channel-value="{{ params.channel }}"
  data-breadcrumb-default-breadcrumb-value='{{ defaultBreadcrumb | to_json }}'
  @open-detail="openDetail($event.detail)"
  x-data="{
    isCollapsed: false,
    toggleSidebar(v) {
      this.isCollapsed = v;
      localStorage.setItem('sidebar-collapsed-status', this.isCollapsed);
      window.dispatchEvent(new CustomEvent('sidebar-collapsed-status-changed', { detail: this.isCollapsed }));
    },
    handleSidebarClick(event) {
      const isDesktop = window.matchMedia('(width >= 64rem)').matches;
      if (isDesktop) return;

      document.querySelector('#my-drawer-3').click()
    },
    attachmentsBaseSrc: '{{ statics['attachments'] }}',
    attachmentsQuery: {},
    attachmentsSrc: '',
    attachmentSrc: '{{ statics['attachments'] }}',
    skipNextWatch: false,
    showDetail: false,
    attachmentTitle: '',
    searchKeyword: '',
    sizeMin: '',
    sizeMax: '',
    dateStart: '',
    dateEnd: '',
    tagInput: '',
    showAdvancedFilters: false,
    fileTypes: [
      { value: 'image', label: '{{ "templates.index.file_types.image" | t: "图片" }}', icon: 'ri-image-line', icon_color: 'text-blue-500' },
      { value: 'video', label: '{{ "templates.index.file_types.video" | t: "视频" }}', icon: 'ri-video-line', icon_color: 'text-purple-500' },
      { value: 'audio', label: '{{ "templates.index.file_types.audio" | t: "音频" }}', icon: 'ri-audio-line', icon_color: 'text-green-500' },
      { value: 'pdf', label: 'PDF', icon: 'ri-file-pdf-line', icon_color: 'text-red-500' },
      { value: 'ppt', label: 'PPT', icon: 'ri-file-ppt-line', icon_color: 'text-orange-500' },
      { value: 'word', label: 'Word', icon: 'ri-file-word-line', icon_color: 'text-blue-600' },
      { value: 'excel', label: 'Excel', icon: 'ri-file-excel-line', icon_color: 'text-green-600' },
      { value: 'archive', label: '{{ "templates.index.file_types.archive" | t: "压缩包" }}', icon: 'ri-file-zip-line', icon_color: 'text-yellow-500' },
      { value: 'other', label: '{{ "templates.index.file_types.other" | t: "其他" }}', icon: 'ri-file-line', icon_color: 'text-gray-500' },
    ],
    init() {
      this.isCollapsed = localStorage.getItem('sidebar-collapsed-status') === 'true';
      this.attachmentsQuery = this.$getQueryParams(window.location.href)

      // 初始化 resource_tags 为数组
      if (this.attachmentsQuery.resource_tags) {
        if (!Array.isArray(this.attachmentsQuery.resource_tags)) {
          // 如果是单个值，转换为数组
          this.attachmentsQuery.resource_tags = [this.attachmentsQuery.resource_tags];
        }
      } else {
        this.attachmentsQuery.resource_tags = [];
      }

      // 初始化 file_type 为数组
      if (this.attachmentsQuery.file_type) {
        if (!Array.isArray(this.attachmentsQuery.file_type)) {
          // 如果是单个值，转换为数组
          this.attachmentsQuery.file_type = [this.attachmentsQuery.file_type];
        }
      } else {
        this.attachmentsQuery.file_type = [];
      }

      // 初始化搜索关键词
      this.searchKeyword = this.attachmentsQuery.search_q || '';

      // 初始化文件大小范围
      this.sizeMin = this.attachmentsQuery.size_min || '';
      this.sizeMax = this.attachmentsQuery.size_max || '';

      // 初始化 channel 参数
      this.channel = this.attachmentsQuery.channel || '';

      // 初始化时间范围筛选
      this.dateStart = this.attachmentsQuery.date_start || '';
      this.dateEnd = this.attachmentsQuery.date_end || '';

      // 检查是否有筛选参数，如果有则自动展开高级筛选
      const hasFilters = this.attachmentsQuery.date_start ||
                        this.attachmentsQuery.date_end ||
                        (this.attachmentsQuery.file_type && this.attachmentsQuery.file_type.length > 0) ||
                        this.attachmentsQuery.size_min ||
                        this.attachmentsQuery.size_max ||
                        (this.attachmentsQuery.resource_tags && this.attachmentsQuery.resource_tags.length > 0);
      this.showAdvancedFilters = hasFilters || false;

      // 检查是否有open_item参数（从403页面登录后重定向回来）
      const openItem = this.attachmentsQuery.open_item;
      if (openItem) {
        // 从URL中删除open_item参数
        delete this.attachmentsQuery.open_item;
        this.$updateQuery(this.attachmentsQuery, 'replace');

        // 等待turbo-frame加载完成后，滚动到对应资源并打开详情
        const attachmentsFrame = document.getElementById('attachments_frame');
        if (attachmentsFrame) {
          const handleFrameLoad = () => {
            this.openItemBySlug(openItem);
            attachmentsFrame.removeEventListener('turbo:frame-load', handleFrameLoad);
          };
          attachmentsFrame.addEventListener('turbo:frame-load', handleFrameLoad, { once: true });
        }
      }

      this.updateAttachmentsSrc();
      this.temPage = this.attachmentsQuery._page;
      this.$watch('attachmentsQuery', (newValue, oldValue) => {
        this.closeDetail();
        this.searchKeyword = this.attachmentsQuery.search_q;
        if (this.skipNextWatch) {
          this.skipNextWatch = false;
          return;
        }
        if (this.temPage && this.attachmentsQuery._page == this.temPage) {
          this.skipNextWatch = true;
          delete this.attachmentsQuery._page;
        }
        this.temPage = this.attachmentsQuery._page;
        this.updateAttachmentsSrc(true);
      }, { deep: true });
      window.addEventListener('popstate', () => {
        this.skipNextWatch = true;
        this.attachmentsQuery = this.$getQueryParams(window.location.href);
        // 同步 resource_tags 为数组
        if (this.attachmentsQuery.resource_tags) {
          if (!Array.isArray(this.attachmentsQuery.resource_tags)) {
            // 如果是单个值，转换为数组
            this.attachmentsQuery.resource_tags = [this.attachmentsQuery.resource_tags];
          }
        } else {
          this.attachmentsQuery.resource_tags = [];
        }
        // 同步 file_type 为数组
        if (this.attachmentsQuery.file_type) {
          if (!Array.isArray(this.attachmentsQuery.file_type)) {
            // 如果是单个值，转换为数组
            this.attachmentsQuery.file_type = [this.attachmentsQuery.file_type];
          }
        } else {
          this.attachmentsQuery.file_type = [];
        }
        // 同步搜索关键词
        this.searchKeyword = this.attachmentsQuery.search_q || '';
        // 同步文件大小范围
        this.sizeMin = this.attachmentsQuery.size_min || '';
        this.sizeMax = this.attachmentsQuery.size_max || '';
        // 同步 channel 参数
        this.channel = this.attachmentsQuery.channel || '';
        // 同步时间范围
        this.dateStart = this.attachmentsQuery.date_start || '';
        this.dateEnd = this.attachmentsQuery.date_end || '';
        // 同步高级筛选展开状态
        const hasFilters = this.attachmentsQuery.date_start ||
                          this.attachmentsQuery.date_end ||
                          (this.attachmentsQuery.file_type && this.attachmentsQuery.file_type.length > 0) ||
                          this.attachmentsQuery.size_min ||
                          this.attachmentsQuery.size_max ||
                          (this.attachmentsQuery.resource_tags && this.attachmentsQuery.resource_tags.length > 0);
        this.showAdvancedFilters = hasFilters || false;
        this.updateAttachmentsSrc(false);
      });
      // 监听移动端 modal 关闭事件
      const modal = document.getElementById('mobile-detail-modal');
      if (modal) {
        modal.addEventListener('close', () => {
          this.showDetail = false;
          this.attachmentSrc = '';
        });
      }
    },
    openItemBySlug(fullSlug) {
      // 构建item的id（将full_slug中的/和.替换为-）
      const itemId = 'item-' + fullSlug.replace(/\//g, '-').replace(/\./g, '-');
      const targetItem = document.getElementById(itemId);

      if (targetItem) {
        // 滚动到目标元素
        targetItem.scrollIntoView({ behavior: 'smooth', block: 'center' });

        // 等待滚动完成后触发点击事件打开详情
        setTimeout(() => {
          targetItem.click();
        }, 300);
      }
    },
    submitSearch() {
      // 将搜索关键词同步到查询参数
      if (this.searchKeyword && this.searchKeyword.trim()) {
        this.attachmentsQuery.search_q = this.searchKeyword.trim();
      } else {
        delete this.attachmentsQuery.search_q;
      }
      this.updateAttachmentsSrc(true);
    },
    updateAttachmentsSrc(push = false) {
      $nextTick(() => {
        // 清理空值参数
        const cleanedQuery = { ...this.attachmentsQuery };
        Object.keys(cleanedQuery).forEach(key => {
          const value = cleanedQuery[key];
          // 删除空值、null、undefined
          if (value === '' || value === null || value === undefined) {
            delete cleanedQuery[key];
          }
          // 删除空数组
          if (Array.isArray(value) && value.length === 0) {
            delete cleanedQuery[key];
          }
        });
        this.attachmentsSrc = this.$buildUrl(this.attachmentsBaseSrc, cleanedQuery);
        if (push) this.$updateQuery(cleanedQuery);
      });
    },
    openDetail(item) {
      this.attachmentTitle = item.title;
      this.attachmentSrc = this.$buildUrl(this.attachmentsBaseSrc, { full_slug: item.full_slug });
      this.showDetail = true;
      // 移动端打开 modal
      if (window.innerWidth < 768) {
        const modal = document.getElementById('mobile-detail-modal');
        if (modal) {
          modal.showModal();
        }
      }
    },
    closeDetail() {
      this.showDetail = false;
      // 移动端关闭 modal
      const modal = document.getElementById('mobile-detail-modal');
      if (modal) {
        modal.close();
      }
    },
    toggleTag(tagName) {
      if (!this.attachmentsQuery.resource_tags) {
        this.attachmentsQuery.resource_tags = [];
      }
      const index = this.attachmentsQuery.resource_tags.indexOf(tagName);
      if (index > -1) {
        this.attachmentsQuery.resource_tags.splice(index, 1);
      } else {
        this.attachmentsQuery.resource_tags.push(tagName);
      }
      // 如果数组为空，删除该属性
      if (this.attachmentsQuery.resource_tags.length === 0) {
        delete this.attachmentsQuery.resource_tags;
      }
      this.updateAttachmentsSrc(true);
    },
    isTagSelected(tagName) {
      return this.attachmentsQuery.resource_tags && this.attachmentsQuery.resource_tags.includes(tagName);
    },
    removeTag(tagName) {
      if (this.attachmentsQuery.resource_tags) {
        const index = this.attachmentsQuery.resource_tags.indexOf(tagName);
        if (index > -1) {
          this.attachmentsQuery.resource_tags.splice(index, 1);
        }
        if (this.attachmentsQuery.resource_tags.length === 0) {
          delete this.attachmentsQuery.resource_tags;
        }
        this.updateAttachmentsSrc(true);
      }
    },
    toggleFileType(fileType) {
      if (!this.attachmentsQuery.file_type) {
        this.attachmentsQuery.file_type = [];
      }
      const index = this.attachmentsQuery.file_type.indexOf(fileType);
      if (index > -1) {
        this.attachmentsQuery.file_type.splice(index, 1);
      } else {
        this.attachmentsQuery.file_type.push(fileType);
      }
      // 如果数组为空，删除该属性
      if (this.attachmentsQuery.file_type.length === 0) {
        delete this.attachmentsQuery.file_type;
      }
      this.updateAttachmentsSrc(true);
    },
    isFileTypeSelected(fileType) {
      return this.attachmentsQuery.file_type && this.attachmentsQuery.file_type.includes(fileType);
    },
    removeFileType(fileType) {
      if (this.attachmentsQuery.file_type) {
        const index = this.attachmentsQuery.file_type.indexOf(fileType);
        if (index > -1) {
          this.attachmentsQuery.file_type.splice(index, 1);
        }
        if (this.attachmentsQuery.file_type.length === 0) {
          delete this.attachmentsQuery.file_type;
        }
        this.updateAttachmentsSrc(true);
      }
    },
    getFileTypeLabel(fileType) {
      const found = this.fileTypes.find(ft => ft.value === fileType);
      return found ? found.label : fileType;
    },
    clearAllTags() {
      delete this.attachmentsQuery.resource_tags;
      this.updateAttachmentsSrc(true);
    },
    clearAllFileTypes() {
      delete this.attachmentsQuery.file_type;
      this.updateAttachmentsSrc(true);
    },
    updateSizeFilter(type, value) {
      // 设置 skipNextWatch 避免触发 watch
      this.skipNextWatch = true;
      if (type === 'min') {
        this.sizeMin = value;
        if (value && value.trim() !== '') {
          this.attachmentsQuery.size_min = value;
        } else {
          delete this.attachmentsQuery.size_min;
        }
      } else if (type === 'max') {
        this.sizeMax = value;
        if (value && value.trim() !== '') {
          this.attachmentsQuery.size_max = value;
        } else {
          delete this.attachmentsQuery.size_max;
        }
      }
      this.updateAttachmentsSrc(true);
    },
    updateChannel(channelPath) {
      if (channelPath && channelPath.trim() !== '') {
        this.attachmentsQuery.channel = channelPath.trim();
        this.channel = channelPath.trim();
      } else {
        delete this.attachmentsQuery.channel;
        this.channel = '';
      }
      this.updateAttachmentsSrc(true);
    },
    setDateRange(startDate, endDate) {
      this.skipNextWatch = true;
      this.dateStart = startDate || '';
      this.dateEnd = endDate || '';
      if (startDate && startDate.trim() !== '') {
        this.attachmentsQuery.date_start = startDate.trim();
      } else {
        delete this.attachmentsQuery.date_start;
      }
      if (endDate && endDate.trim() !== '') {
        this.attachmentsQuery.date_end = endDate.trim();
      } else {
        delete this.attachmentsQuery.date_end;
      }
      this.updateAttachmentsSrc(true);
    },
    updateDateStart(value) {
      this.skipNextWatch = true;
      this.dateStart = value || '';
      if (value && value.trim() !== '') {
        this.attachmentsQuery.date_start = value.trim();
      } else {
        delete this.attachmentsQuery.date_start;
      }
      this.updateAttachmentsSrc(true);
    },
    updateDateEnd(value) {
      this.skipNextWatch = true;
      this.dateEnd = value || '';
      if (value && value.trim() !== '') {
        this.attachmentsQuery.date_end = value.trim();
      } else {
        delete this.attachmentsQuery.date_end;
      }
      this.updateAttachmentsSrc(true);
    },
    clearDateRange() {
      this.skipNextWatch = true;
      this.dateStart = '';
      this.dateEnd = '';
      delete this.attachmentsQuery.date_start;
      delete this.attachmentsQuery.date_end;
      this.updateAttachmentsSrc(true);
    },
    clearDateStart() {
      this.skipNextWatch = true;
      this.dateStart = '';
      delete this.attachmentsQuery.date_start;
      this.updateAttachmentsSrc(true);
    },
    clearDateEnd() {
      this.skipNextWatch = true;
      this.dateEnd = '';
      delete this.attachmentsQuery.date_end;
      this.updateAttachmentsSrc(true);
    },
    applySizeRange(min, max) {
      this.skipNextWatch = true;
      this.sizeMin = min ? `${min}` : '';
      this.sizeMax = max ? `${max}` : '';
      if (min !== undefined && min !== null && min !== '') {
        this.attachmentsQuery.size_min = `${min}`;
      } else {
        delete this.attachmentsQuery.size_min;
      }
      if (max !== undefined && max !== null && max !== '') {
        this.attachmentsQuery.size_max = `${max}`;
      } else {
        delete this.attachmentsQuery.size_max;
      }
      this.updateAttachmentsSrc(true);
    },
    isSizeRangeActive(min, max) {
      const currentMin = this.attachmentsQuery.size_min || '';
      const currentMax = this.attachmentsQuery.size_max || '';

      // 处理 min 的比较：当 min 是 0 或空时，如果 currentMin 也是空或 '0'，认为匹配
      const minMatch = (min === 0 || min === '' || min === null || min === undefined)
        ? (currentMin === '' || currentMin === '0' || currentMin === null || currentMin === undefined)
        : `${min}` === `${currentMin}`;

      // 处理 max 的比较
      const maxMatch = (max === '' || max === null || max === undefined)
        ? (currentMax === '' || currentMax === null || currentMax === undefined)
        : `${max}` === `${currentMax}`;

      return minMatch && maxMatch;
    },
    resetFilters() {
      window.location.href = '/';
    },
    toggleAdvancedFilters() {
      this.showAdvancedFilters = !this.showAdvancedFilters;
    },
    setSortByEditedAt() {
      this.attachmentsQuery.sort = '-edited_at';
      this.updateAttachmentsSrc(true);
    },
    setSortByVisitsCount() {
      this.attachmentsQuery.sort = '-visits_count';
      this.updateAttachmentsSrc(true);
    },
    isSortByEditedAt() {
      return this.attachmentsQuery.sort === '-edited_at';
    },
    isSortByVisitsCount() {
      return this.attachmentsQuery.sort === '-visits_count';
    },
    updateResourceTags(event) {
      // 处理标签选择器的事件
      const tags = event.detail?.tags || [];
      if (tags.length > 0) {
        this.attachmentsQuery.resource_tags = tags;
      } else {
        delete this.attachmentsQuery.resource_tags;
      }
      this.updateAttachmentsSrc(true);
    }
  }"
>
  {% comment %} 左侧边栏 {% endcomment %}
  {% render 'aside', page: page %}

  {% comment %} 主内容区 {% endcomment %}
  <main class="flex-1 h-full bg-gray-50 overflow-y-auto min-h-[calc(100vh-80px)]" data-controller="image-zoom">
    <div class="flex-1 flex flex-col px-2 py-2 md:px-6 md:py-4 min-h-[calc(100vh-80px)]">
      <div class='flex-0' data-image-zoom-target="zoomControl"></div>

      <!-- 筛选区域 -->
      <div class="flex-0 bg-white rounded-lg shadow-sm p-3 md:p-6 mb-4 space-y-4 text-sm">
        <!-- 关键词搜索和操作按钮 -->
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 md:gap-4"  :class="showAdvancedFilters ? '': 'mb-0'">
          <div class="flex flex-col md:flex-row md:items-start flex-1 gap-2 md:gap-0">
            <span class="hidden md:inline-block w-18 md:w-24 shrink-0 text-gray-500 pt-1.5">{{ "templates.index.filters.keyword" | t: "关键词" }}</span>
            <div class="flex-1 flex flex-wrap gap-3 items-center w-full">
              <div class="join w-full md:max-w-lg">
                <input type="text" class="input input-bordered input-sm join-item flex-1 bg-gray-50 h-9 text-sm"
                  placeholder='{{ "templates.index.filters.keyword_placeholder" | t: "输入关键词搜索资源..." }}' x-model="searchKeyword" @keydown.enter.prevent="submitSearch">
                <button class="btn btn-primary join-item bg-blue-600 border-blue-600 text-white h-9 min-h-0 px-3 md:px-4"
                  @click="submitSearch">
                  <i class="ri-search-2-line"></i> <span class="hidden sm:inline">{{ "templates.index.actions.search" | t: "搜索" }}</span>
                </button>
              </div>
            </div>
          </div>
          <!-- 重置和高级筛选按钮 -->
          <div class="flex items-center gap-2 md:gap-1 shrink-0">
            <button class="btn btn-sm btn-link text-gray-600 hover:text-red-700 hover:bg-red-50 px-2 md:px-4"
              @click="resetFilters">
              {{ "templates.index.actions.reset" | t: "重置" }}
            </button>
            <button class="btn btn-sm btn-link px-2 md:px-4"
              :class="showAdvancedFilters ? 'btn-primary' : 'btn-ghost text-gray-600 hover:bg-gray-100'"
              @click="toggleAdvancedFilters">
              <span class="hidden sm:inline">{{ "templates.index.actions.advanced_filters" | t: "高级筛选" }}</span>
              <span class="sm:hidden">{{ "templates.index.actions.filters" | t: "筛选" }}</span>
            </button>
          </div>
        </div>

        <!-- 高级筛选区域 -->
        <div x-show="showAdvancedFilters" x-cloak x-transition class="space-y-4">
          <!-- 时间范围筛选 -->
          <div class="flex flex-col md:flex-row md:items-start gap-2 md:gap-0">
            <span class="hidden md:inline-block w-18 md:w-24 shrink-0 text-gray-500 pt-1.5">{{ "templates.index.filters.date_range" | t: "时间范围" }}</span>
            <div class="flex-1 flex flex-col md:flex-row md:flex-wrap gap-2 md:gap-3 md:items-center">
              <div class="flex items-center gap-2 w-full md:w-auto">
                <div class="relative flex-1 md:flex-none">
                  <input type="date"
                    class="w-full md:min-w-[110px] input input-bordered input-sm bg-gray-50 h-9 pr-9 text-sm"
                    x-model="dateStart"
                    @change="updateDateStart(dateStart)"
                    placeholder='{{ "templates.index.filters.start_date" | t: "开始日期" }}'>
                  <button
                    class="absolute right-7 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-200 rounded-full cursor-pointer transition-colors z-10"
                    @click.stop="clearDateStart"
                    x-show="dateStart"
                    type="button"
                    title='{{ "templates.index.filters.clear_start_date" | t: "清除开始日期" }}'>
                    <i class="ri-close-line text-xs"></i>
                  </button>
                </div>
                <span class="text-gray-400 hidden md:inline">-</span>
                <div class="relative flex-1 md:flex-none">
                  <input type="date"
                    class="w-full md:min-w-[110px] input input-bordered input-sm bg-gray-50 h-9 pr-9 text-sm"
                    x-model="dateEnd"
                    @change="updateDateEnd(dateEnd)"
                    placeholder='{{ "templates.index.filters.end_date" | t: "结束日期" }}'>
                  <button
                    class="absolute right-7 top-1/2 -translate-y-1/2 w-5 h-5 flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-200 rounded-full cursor-pointer transition-colors z-10"
                    @click.stop="clearDateEnd"
                    x-show="dateEnd"
                    type="button"
                    title='{{ "templates.index.filters.clear_end_date" | t: "清除结束日期" }}'>
                    <i class="ri-close-line text-xs"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- 文件类型 -->
          <div class="flex flex-col md:flex-row md:items-start gap-2 md:gap-0">
            <span class="hidden md:inline-block w-18 md:w-24 shrink-0 text-gray-500 pt-1.5">{{ "templates.index.filters.file_type" | t: "文件类型" }}</span>
            <div class="flex-1 grid grid-cols-4 md:flex flex-wrap gap-2 md:gap-3 items-center">
              <button class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="!attachmentsQuery.file_type || attachmentsQuery.file_type.length === 0 ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="clearAllFileTypes()">{{ "templates.index.filters.all" | t: "全部" }}</button>
              <template x-for="fileType in fileTypes" :key="fileType.value">
                <button
                  class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                  :class="isFileTypeSelected(fileType.value) ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                  @click="toggleFileType(fileType.value)">
                  <i :class="fileType.icon + ' text-sm ' + fileType.icon_color"></i>
                  <span x-text="fileType.label"></span>
                </button>
              </template>
            </div>
          </div>

          <!-- 文件大小 -->
          <div class="flex flex-col md:flex-row md:items-start gap-2 md:gap-0">
            <span class="hidden md:inline-block w-18 md:w-24 shrink-0 text-gray-500 pt-1.5">{{ "templates.index.filters.file_size" | t: "文件大小" }}</span>
            <div class="flex-1 grid grid-cols-4 md:flex flex-wrap gap-2 md:gap-3 items-center">
              <button
                class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="isSizeRangeActive('', '') ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="applySizeRange('', '')">{{ "templates.index.filters.all" | t: "全部" }}</button>
              <button
                class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="isSizeRangeActive(0, 10) ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="applySizeRange(0, 10)">0-10MB</button>
              <button
                class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="isSizeRangeActive(10, 50) ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="applySizeRange(10, 50)">10-50MB</button>
              <button
                class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="isSizeRangeActive(50, 100) ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="applySizeRange(50, 100)">50-100MB</button>
              <button
                class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="isSizeRangeActive(100, 1024) ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="applySizeRange(100, 1024)">100MB-1GB</button>
              <button
                class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="isSizeRangeActive(1024, 10240) ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="applySizeRange(1024, 10240)">1GB-10GB</button>
              <button
                class="px-3 md:px-4 py-1.5 rounded-md cursor-pointer transition-all duration-200 border text-xs md:text-sm"
                :class="isSizeRangeActive(10240, 102400) ? 'bg-indigo-100 border-indigo-200 text-blue-600 font-medium' : 'bg-white border-transparent text-gray-600 hover:bg-gray-100 hover:text-blue-600'"
                @click="applySizeRange(10240, 102400)">
                  &gt;10GB
                </button>
            </div>
          </div>

          <!-- 标签筛选 -->
          <div data-controller="tag-selector" data-tag-selector-url-value="{{ statics['tag_search'] }}" @tags-changed="updateResourceTags($event)">
            {% render 'tag_selector', label: "templates.index.filters.tag_filter" | t: "标签筛选" %}
          </div>
        </div>
      </div>

      <!-- 排序工具栏 -->
      <div class="flex-0 flex justify-between items-center pb-4">
        <div class="flex gap-2">
          <button
            @click="setSortByEditedAt()"
            class="px-5 py-2 rounded-md text-sm cursor-pointer transition-all duration-200 border-none flex items-center gap-1.5"
            :class="isSortByEditedAt() ? 'bg-blue-600 text-white' : 'bg-white text-gray-500 hover:text-blue-600'">
            <i class="ri-time-line"></i>
            <span>{{ "templates.index.sort.latest_uploaded" | t: "最新上传" }}</span>
          </button>
          <button
            @click="setSortByVisitsCount()"
            class="px-5 py-2 rounded-md text-sm cursor-pointer transition-all duration-200 border-none flex items-center gap-1.5"
            :class="isSortByVisitsCount() ? 'bg-blue-600 text-white' : 'bg-white text-gray-500 hover:text-blue-600'">
            <i class="ri-fire-line"></i>
            <span>{{ "templates.index.sort.most_viewed" | t: "最多浏览" }}</span>
          </button>
        </div>

        {% comment %} 排序规则 {% endcomment %}
        <div class="relative" x-data="{
                      sortKey: 'created_at',
                      sortOrder: 'desc',
                      init() {
                        if (attachmentsQuery.sort) {
                          this.updateSort(attachmentsQuery.sort)
                        }
                        this.$watch('attachmentsQuery.sort', (sort) => {
                          this.updateSort(sort)
                        }, { deep: true });
                      },
                      updateSort(value) {
                        if (value && value.startsWith('-')) {
                          this.sortKey = value.substring(1)
                          this.sortOrder = 'desc'
                        } else if (value) {
                          this.sortKey = value
                          this.sortOrder = 'asc'
                        } else {
                          this.sortKey = 'created_at'
                          this.sortOrder = 'desc'
                        }
                      }
                    }
                    ">
          <button
            class="btn btn-sm btn-outline border-gray-300 hover:bg-gray-50 text-gray-600 gap-2"
            popovertarget="popover-sort-options-menu" style="anchor-name:--sort-options-menu" title='{{ "templates.index.sort.rules" | t: "排序规则" }}'>
            <i class="ri-filter-3-line"></i>
            <span>{{ "templates.index.sort.sort" | t: "排序" }}</span>
            <i class="ri-arrow-down-s-line"></i>
          </button>
          <div class="dropdown dropdown-end menu w-52 rounded-box bg-base-100 shadow-sm" popover x-ref="popover1"
            @click="$refs.popover1.hidePopover()" id="popover-sort-options-menu" style="position-anchor:--sort-options-menu">
            <div @click="attachmentsQuery.sort = sortOrder === 'desc' ? '-created_at' : 'created_at'"
              class="flex items-center justify-between px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer">
              <div class="flex items-center gap-2">
                <i class="ri-calendar-line"></i>
                <span>{{ "templates.index.sort.by_created_at" | t: "按创建时间" }}</span>
              </div>
              <i class="ri-check-line text-primary" x-show="sortKey === 'created_at'"></i>
            </div>
            <div @click="attachmentsQuery.sort = sortOrder === 'desc' ? '-edited_at' : 'edited_at'"
              class="flex items-center justify-between px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer">
              <div class="flex items-center gap-2">
                <i class="ri-edit-line"></i>
                <span>{{ "templates.index.sort.by_edited_at" | t: "按修改时间" }}</span>
              </div>
              <i class="ri-check-line text-primary" x-show="sortKey === 'edited_at'"></i>
            </div>
            <div class="divider my-1"></div>
            <div @click="attachmentsQuery.sort = sortKey"
              class="flex items-center justify-between px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer">
              <div class="flex items-center gap-2">
                <i class="ri-arrow-up-line"></i>
                <span>{{ "templates.index.sort.asc" | t: "升序" }}</span>
              </div>
              <i class="ri-check-line text-primary" x-show="sortOrder === 'asc'"></i>
            </div>
            <div @click="attachmentsQuery.sort = '-' + sortKey"
              class="flex items-center justify-between px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 cursor-pointer">
              <div class="flex items-center gap-2">
                <i class="ri-arrow-down-line"></i>
                <span>{{ "templates.index.sort.desc" | t: "降序" }}</span>
              </div>
              <i class="ri-check-line text-primary" x-show="sortOrder === 'desc'"></i>
            </div>
          </div>
        </div>
      </div>

      {% comment %} 图片网格区域 {% endcomment %}
      <div class="flex-1 min-h-0 h-full overflow-auto">
        <turbo-frame class='c' id="attachments_frame" :src="attachmentsSrc">
          <div class="h-[200px] flex items-center justify-center text-gray-500 dark:text-gray-400">
            <span class="loading loading-spinner loading-md"></span>
          </div>
        </turbo-frame>
      </div>
    </div>

    <div class="flex-0">
      {% render 'footer' %}
    </div>
  </main>
</div>

{% comment %} 移动端筛选器切换脚本 {% endcomment %}
<script>
  (function () {
    document.addEventListener('DOMContentLoaded', function () {
      const filterToggle = document.getElementById('mobile-filter-toggle');
      const filterPanel = document.getElementById('mobile-filter-panel');
      const filterIcon = document.getElementById('mobile-filter-icon');

      if (filterToggle && filterPanel && filterIcon) {
        filterToggle.addEventListener('click', function () {
          const isHidden = filterPanel.classList.contains('hidden');

          if (isHidden) {
            filterPanel.classList.remove('hidden');
            filterIcon.style.transform = 'rotate(180deg)';
          } else {
            filterPanel.classList.add('hidden');
            filterIcon.style.transform = 'rotate(0deg)';
          }
        });
      }
    });
  })();
</script>