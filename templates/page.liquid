{% schema %}
  {
    "name": "t:schema.templates.page.name",
    "description": "",
    "thumb_url": "images/theme/${lang}/page.png",
    "preview_image_urls": [
      "images/theme/${lang}/page.png"
    ],
    "batch_create_url": "/s/batch_import",
    "settings": [
      {
        "id": "title",
        "type": "text",
        "label": "t:schema.templates.page.settings.title.label"
      },
      {
        "id": "asset",
        "type": "dam_picker",
        "label": "t:schema.templates.page.settings.asset.label",
        "queryable": {
          "metadata": {
            "fields": ["filename", "size", "kind"]
          }
        }
      },
      {
        "id": "resource_tags",
        "type": "tag_picker",
        "label": "t:schema.templates.page.settings.resource_tags.label",
        "queryable": true,
        "multiple": true
      },
      {
        "id": "resource_types",
        "type": "select",
        "label": "t:schema.templates.page.settings.resource_types.label",
        "info": "t:schema.templates.page.settings.resource_types.info",
        "choices_from": "$site.resource_types",
        "queryable": true,
        "multiple": true
      },
      {
        "id": "content",
        "type": "richtext",
        "label": "t:schema.templates.page.settings.content.label",
        "searchable": true
      }
    ]
  }
{% endschema %}

<main class="flex-1 bg-gray-50 overflow-y-auto">
  {% assign entity = page.settings.asset %}

  <div class="px-2 py-2 md:px-8 md:py-6 min-h-[calc(100vh-80px)]">
    <!-- Breadcrumbs -->
    <div class="mb-2">
      {% render 'breadcrumb', breadcrumb: page.breadcrumb %}
    </div>

    {% if entity and entity.image? %}
      {% render 'attachment/image', page: page, entity: entity %}
    {% elsif entity and entity.video? %}
      {% render 'attachment/video', page: page, entity: entity %}
    {% elsif entity and entity.audio? %}
      {% render 'attachment/audio', page: page, entity: entity %}
    {% elsif entity and entity.pdf? %}
      {% render 'attachment/pdf', page: page, entity: entity %}
    {% elsif entity and entity.metadata.kind == 'word' %}
      {% render 'attachment/word', page: page, entity: entity %}
    {% elsif entity and entity.metadata.kind == 'excel' %}
      {% render 'attachment/excel', page: page, entity: entity %}
    {% elsif entity and entity.metadata.kind == 'ppt' %}
      {% render 'attachment/ppt', page: page, entity: entity %}
    {% elsif entity and entity.metadata.kind == 'archive' %}
      {% render 'attachment/archive', page: page, entity: entity %}
    {% else %}
      {% render 'attachment/other', page: page, entity: entity %}
    {% endif %}

  </div>

  <!-- Footer -->
  {% render 'footer' %}
</main>
