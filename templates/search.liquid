<main class="min-h-[calc(100vh-80px)] flex-1 overflow-y-auto bg-gray-50">
  <div class="px-4 py-6 md:px-8">
    <h1 class="mb-4 text-2xl font-bold text-gray-900">{{ "templates.search.title" | t }}</h1>
    {% render 'search_form' %}

    <turbo-frame id="frame--search-results">
      {% if search.keywords or search.tag %}
        <div class="space-y-3">
          {% if search.page_number == 1 %}
            {% for link in search.extends %}
              <article class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                <a href="{{ link.url }}" class="block text-base font-semibold text-gray-900 hover:text-primary search-highlight-block" data-turbo-frame="_top">{{ link.link_text }}</a>
                <p class="mt-1 line-clamp-2 text-xs text-gray-500 search-highlight-block">{{ link.url }}</p>
              </article>
            {% endfor %}
          {% endif %}
          {% paginate_tag search.pages, as: 'items' %}
            {% for page in items %}
              <article class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition hover:border-primary/40">
                <h2 class="text-base font-semibold text-gray-900">
                  <a href="{{ page.path }}" class="hover:text-primary search-highlight-block" data-turbo-frame="_top">{{ page.highlighted_search_title }}</a>
                </h2>
                <p class="mt-1 line-clamp-3 text-sm text-gray-600 search-highlight-block">{{ page.highlighted_search_content }}</p>
              </article>
            {% else %}
              <p class="rounded-lg border border-dashed border-gray-300 bg-white px-4 py-16 text-center text-sm text-gray-500">{{ "templates.search.empty" | t }}</p>
            {% endfor %}
            <div class="mt-6">{% render 'paginate' %}</div>
          {% endpaginate_tag %}
        </div>
      {% else %}
        <p class="rounded-lg border border-dashed border-gray-300 bg-white px-4 py-16 text-center text-sm text-gray-500">{{ "templates.search.prompt" | t }}</p>
      {% endif %}
    </turbo-frame>
  </div>
</main>
